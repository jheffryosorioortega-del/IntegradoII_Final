# Copia este archivo como ".env" (mismo nombre, sin ".example") y completa las claves.
# El archivo ".env" NO se sube a GitHub (está en .gitignore). No pongas claves reales aquí.
#
# Lo leen los microservicios cuando se ejecutan con el perfil "bd" (bases de datos reales):
# cada uno usa SOLO la clave de su propia base.
#
# Sugerencia: claves largas y distintas para cada base. Si tu clave tiene símbolos, evita las comillas y el #.
# Estas mismas claves son las que pones en los scripts de docs/sql al crear los usuarios de cada base.

# ms-usuarios -> PostgreSQL
USUARIOS_DB_PASSWORD=

# ms-clientes -> PostgreSQL
CLIENTES_DB_PASSWORD=

# ms-solicitudes -> PostgreSQL
SOLICITUDES_DB_PASSWORD=

# Carpeta donde viven los archivos de las bases de datos (modo sin perfil "bd", con H2).
# Ruta ABSOLUTA con barras normales (/), por ejemplo: C:/Users/tu-usuario/.../AvanceIntegrador/BaseDB_InteII
# Si no la defines, se usa la carpeta ../BaseDB_InteII relativa a donde se ejecuta el servicio.
# (Déjala comentada con # si no la necesitas: una línea vacía NO equivale a "no definida".)
# SGP_BD_CARPETA=C:/Users/tu-usuario/ruta/AvanceIntegrador/BaseDB_InteII
# Consulta DNI (solo servidor). Completar en .env, nunca en JavaScript.
DECOLECTA_TOKEN=
SGP_DNI_INTERNAL_KEY=

# Servidor PostgreSQL donde estan las 3 bases (sgp_usuarios, sgp_clientes, sgp_solicitudes).
SGP_DB_HOST=localhost
SGP_DB_PORT=5432

# Clave compartida entre Front-End, Gateway y microservicios (cabecera X-SGP-Api-Key). Usa una cadena larga y aleatoria,
# la misma en .env de todos los servicios. Sin ella, todas las peticiones a /api se rechazan con 403.
SGP_API_KEY=

# Secreto para firmar y verificar los JWT de sesion (ms-usuarios firma, el Gateway verifica). Cadena aleatoria de 32 o mas caracteres.
# Sin el, ms-usuarios no arranca y el Gateway rechaza las rutas que exigen sesion.
SGP_JWT_SECRET=

# Contraseña con la que se crean los 3 usuarios iniciales (admin@sgp.local, coordinador@sgp.local, tecnico@sgp.local)
# la primera vez que ms-usuarios arranca con la tabla de usuarios vacía. Mínimo 10 caracteres.
# Si la tabla ya tiene usuarios, esta variable no cambia sus contraseñas. En un servidor público usa una clave larga y única.
SGP_SEED_PASSWORD=

# --- Producción en un servidor (docker-compose.prod.yml, ver docs/DESPLIEGUE_GCP.md) ---
# Solo en el .env DEL SERVIDOR, no en tu PC:
# Dominio que apunta al servidor (Caddy le saca solo el certificado HTTPS). Ejemplo: sgp-polanco.duckdns.org
# SGP_DOMINIO=
# Para no escribir los dos -f en cada comando (en Linux el separador es ":"):
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# Copias de seguridad: hora de Lima de la copia diaria, días que se conservan y carpeta donde se guardan.
# SGP_BACKUP_HORA=03:00
# SGP_BACKUP_DIAS=14
# SGP_BACKUP_CARPETA=./backups

# --- Docker (docker compose up) ---
# Clave del administrador (usuario postgres) del PostgreSQL de Docker. Ningun servicio la usa; solo crea las 3 bases la primera vez.
POSTGRES_PASSWORD=
# Puerto de TU PC desde el que ver el PostgreSQL de Docker (pgAdmin/DBeaver). Por defecto 5433, porque el 5432 suele estar ocupado.
# SGP_PG_PUBLISH_PORT=5433
